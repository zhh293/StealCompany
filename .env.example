# CatDesk Remote Console 配置
PORT=3000
HOST=0.0.0.0
JWT_SECRET=在此填入随机生成的密钥（运行 node scripts/setup.js 自动生成）
JWT_EXPIRES_IN=24h

# 认证（运行 node scripts/create-user.js 生成密码哈希）
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# 工作目录白名单（逗号分隔，根据你的系统填写）
# Windows 示例:
#   ALLOWED_DIRS=C:\Users\你的用户名\Desktop,C:\Users\你的用户名\Documents,D:\,E:\
#   DEFAULT_WORKSPACE=C:\Users\你的用户名\Desktop
# macOS/Linux 示例:
#   ALLOWED_DIRS=/home/你的用户名/Desktop,/home/你的用户名/Documents
#   DEFAULT_WORKSPACE=/home/你的用户名/Desktop
ALLOWED_DIRS=
DEFAULT_WORKSPACE=

# Claude Code CLI 路径（确保 claude 命令可在终端中直接运行）
CLAUDE_CODE_PATH=claude

# 安全配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TERMINAL_IDLE_TIMEOUT=600000
