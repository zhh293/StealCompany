# CatDesk Remote Console 配置
PORT=3000
HOST=0.0.0.0
JWT_SECRET=your-random-secret-here
JWT_EXPIRES_IN=24h

# 认证（运行 node scripts/create-user.js 生成）
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# 工作目录白名单（逗号分隔）
ALLOWED_DIRS=/Users/zhanghonghao/Desktop,/Users/zhanghonghao/Documents
DEFAULT_WORKSPACE=/Users/zhanghonghao/Desktop

# Claude Code CLI 路径
CLAUDE_CODE_PATH=mc

# 安全配置
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TERMINAL_IDLE_TIMEOUT=600000
